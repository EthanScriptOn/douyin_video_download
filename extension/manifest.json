{
  "manifest_version": 3,
  "name": "抖音媒体拦截",
  "version": "0.3.2",
  "description": "按视频拦截抖音 Web 的 media-video / media-audio，并推送到本机助手拼接。",
  "permissions": [
    "webRequest",
    "storage",
    "tabs",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.douyin.com/*",
    "*://*.douyinvod.com/*",
    "*://*.bytevod.com/*",
    "http://127.0.0.1:18767/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "抖音媒体拦截",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
